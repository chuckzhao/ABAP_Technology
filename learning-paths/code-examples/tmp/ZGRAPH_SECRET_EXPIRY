*&---------------------------------------------------------------------*
*& Report ZGRAPH_SECRET_EXPIRY
*&---------------------------------------------------------------------*
*& Lists Entra ID (Azure AD) app registration client secrets and their
*& expiry dates via Microsoft Graph, flagging ones that are expired or
*& expiring within N days.
*&
*& Prerequisites:
*&  - Azure app used for this call has Graph application permission
*&    Application.Read.All (admin consented)
*&  - STRUST: root/intermediate certs for login.microsoftonline.com and
*&    graph.microsoft.com imported into SSL Client (Anonymous) PSE
*&  - ICM HTTPS enabled; outbound proxy configured if required
*&  - Selection texts maintained (Goto > Text Elements)
*&---------------------------------------------------------------------*
REPORT zgraph_secret_expiry.

*----------------------------------------------------------------------*
* Types
*----------------------------------------------------------------------*
TYPES:
  BEGIN OF ty_pwd_cred,
    display_name    TYPE string,
    key_id          TYPE string,
    hint            TYPE string,
    start_date_time TYPE string,
    end_date_time   TYPE string,
  END OF ty_pwd_cred,
  tt_pwd_cred TYPE STANDARD TABLE OF ty_pwd_cred WITH EMPTY KEY,

  BEGIN OF ty_app,
    app_id               TYPE string,
    display_name         TYPE string,
    password_credentials TYPE tt_pwd_cred,
  END OF ty_app,
  tt_app TYPE STANDARD TABLE OF ty_app WITH EMPTY KEY,

  BEGIN OF ty_graph_page,
    value     TYPE tt_app,
    next_link TYPE string,          " mapped from @odata.nextLink
  END OF ty_graph_page,

  BEGIN OF ty_token,
    token_type   TYPE string,
    expires_in   TYPE i,
    access_token TYPE string,
  END OF ty_token,

  BEGIN OF ty_out,
    light       TYPE c LENGTH 1,    " 1 = red, 2 = yellow, 3 = green
    app_name    TYPE c LENGTH 80,
    app_id      TYPE c LENGTH 36,
    secret_name TYPE c LENGTH 60,
    hint        TYPE c LENGTH 3,
    expiry      TYPE d,
    days_left   TYPE i,
  END OF ty_out,
  tt_out TYPE STANDARD TABLE OF ty_out WITH EMPTY KEY,

  BEGIN OF ty_hdr,
    col TYPE lvc_fname,
    txt TYPE scrtext_l,
  END OF ty_hdr,
  tt_hdr TYPE STANDARD TABLE OF ty_hdr WITH EMPTY KEY.

*----------------------------------------------------------------------*
* Selection screen
*----------------------------------------------------------------------*
PARAMETERS: p_tenant TYPE c LENGTH 64  LOWER CASE OBLIGATORY,
            p_client TYPE c LENGTH 64  LOWER CASE OBLIGATORY,
            p_secret TYPE c LENGTH 128 LOWER CASE OBLIGATORY,
            p_days   TYPE i DEFAULT 30,
            p_all    AS CHECKBOX.

*----------------------------------------------------------------------*
* Exception class
*----------------------------------------------------------------------*
CLASS lcx_error DEFINITION INHERITING FROM cx_static_check.
  PUBLIC SECTION.
    DATA mv_text TYPE string READ-ONLY.
    METHODS constructor IMPORTING iv_text TYPE string.
    METHODS get_text REDEFINITION.
ENDCLASS.

CLASS lcx_error IMPLEMENTATION.
  METHOD constructor.
    super->constructor( ).
    mv_text = iv_text.
  ENDMETHOD.
  METHOD get_text.
    result = mv_text.
  ENDMETHOD.
ENDCLASS.

*----------------------------------------------------------------------*
* Graph client
*----------------------------------------------------------------------*
CLASS lcl_graph_client DEFINITION.
  PUBLIC SECTION.
    METHODS constructor
      IMPORTING iv_tenant TYPE string
                iv_client TYPE string
                iv_secret TYPE string.

    METHODS get_applications
      RETURNING VALUE(rt_apps) TYPE tt_app
      RAISING   lcx_error.

  PRIVATE SECTION.
    CONSTANTS c_apps_url TYPE string VALUE
      `https://graph.microsoft.com/v1.0/applications?$select=appId,displayName,passwordCredentials&$top=999`.

    DATA: mv_tenant TYPE string,
          mv_client TYPE string,
          mv_secret TYPE string,
          mv_token  TYPE string.

    METHODS fetch_token
      RAISING lcx_error.

    METHODS http_call
      IMPORTING iv_url          TYPE string
                iv_method       TYPE string
                iv_body         TYPE string OPTIONAL
                iv_content_type TYPE string OPTIONAL
                iv_token        TYPE string OPTIONAL
      RETURNING VALUE(rv_body)  TYPE string
      RAISING   lcx_error.
ENDCLASS.

CLASS lcl_graph_client IMPLEMENTATION.

  METHOD constructor.
    mv_tenant = iv_tenant.
    mv_client = iv_client.
    mv_secret = iv_secret.
  ENDMETHOD.

  METHOD fetch_token.
    " OAuth2 client credentials flow
    DATA(lv_url) = |https://login.microsoftonline.com/{ mv_tenant }/oauth2/v2.0/token|.

    DATA(lv_body) =
      |grant_type=client_credentials| &&
      |&client_id={ cl_http_utility=>escape_url( unescaped = mv_client ) }| &&
      |&client_secret={ cl_http_utility=>escape_url( unescaped = mv_secret ) }| &&
      |&scope=https%3A%2F%2Fgraph.microsoft.com%2F.default|.

    DATA(lv_json) = http_call( iv_url          = lv_url
                               iv_method       = 'POST'
                               iv_body         = lv_body
                               iv_content_type = 'application/x-www-form-urlencoded' ).

    DATA ls_token TYPE ty_token.
    /ui2/cl_json=>deserialize( EXPORTING json = lv_json
                               CHANGING  data = ls_token ).

    IF ls_token-access_token IS INITIAL.
      RAISE EXCEPTION TYPE lcx_error
        EXPORTING iv_text = |No access token returned: { lv_json }|.
    ENDIF.

    mv_token = ls_token-access_token.
  ENDMETHOD.

  METHOD get_applications.
    DATA ls_page TYPE ty_graph_page.

    IF mv_token IS INITIAL.
      fetch_token( ).
    ENDIF.

    DATA(lv_url) = c_apps_url.

    " Follow @odata.nextLink until all pages are read
    WHILE lv_url IS NOT INITIAL.
      DATA(lv_json) = http_call( iv_url    = lv_url
                                 iv_method = 'GET'
                                 iv_token  = mv_token ).
      CLEAR ls_page.
      /ui2/cl_json=>deserialize(
        EXPORTING json          = lv_json
                  pretty_name   = /ui2/cl_json=>pretty_mode-camel_case
                  name_mappings = VALUE #( ( abap = 'NEXT_LINK' json = '@odata.nextLink' ) )
        CHANGING  data          = ls_page ).

      APPEND LINES OF ls_page-value TO rt_apps.
      lv_url = ls_page-next_link.
    ENDWHILE.
  ENDMETHOD.

  METHOD http_call.
    DATA: lo_client TYPE REF TO if_http_client,
          lv_code   TYPE i,
          lv_msg    TYPE string.

    cl_http_client=>create_by_url(
      EXPORTING  url    = iv_url
                 ssl_id = 'ANONYM'
      IMPORTING  client = lo_client
      EXCEPTIONS OTHERS = 1 ).
    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE lcx_error
        EXPORTING iv_text = |Cannot create HTTP client for { iv_url }|.
    ENDIF.

    lo_client->propertytype_logon_popup = if_http_client=>co_disabled.
    lo_client->request->set_method( iv_method ).
    lo_client->request->set_header_field( name = 'Accept' value = 'application/json' ).

    IF iv_content_type IS NOT INITIAL.
      lo_client->request->set_content_type( iv_content_type ).
    ENDIF.
    IF iv_body IS NOT INITIAL.
      lo_client->request->set_cdata( iv_body ).
    ENDIF.
    IF iv_token IS NOT INITIAL.
      lo_client->request->set_header_field( name  = 'Authorization'
                                            value = |Bearer { iv_token }| ).
    ENDIF.

    lo_client->send( EXCEPTIONS OTHERS = 1 ).
    IF sy-subrc = 0.
      lo_client->receive( EXCEPTIONS OTHERS = 1 ).
    ENDIF.
    IF sy-subrc <> 0.
      lo_client->get_last_error( IMPORTING message = lv_msg ).
      lo_client->close( ).
      RAISE EXCEPTION TYPE lcx_error
        EXPORTING iv_text = |HTTP communication error: { lv_msg }|.
    ENDIF.

    lo_client->response->get_status( IMPORTING code = lv_code ).
    rv_body = lo_client->response->get_cdata( ).
    lo_client->close( ).

    IF lv_code <> 200.
      RAISE EXCEPTION TYPE lcx_error
        EXPORTING iv_text = |HTTP { lv_code }: { rv_body }|.
    ENDIF.
  ENDMETHOD.

ENDCLASS.

*----------------------------------------------------------------------*
* Mask the secret on the selection screen
*----------------------------------------------------------------------*
AT SELECTION-SCREEN OUTPUT.
  LOOP AT SCREEN.
    IF screen-name = 'P_SECRET'.
      screen-invisible = '1'.
      MODIFY SCREEN.
    ENDIF.
  ENDLOOP.

*----------------------------------------------------------------------*
* Main
*----------------------------------------------------------------------*
START-OF-SELECTION.

  DATA: lt_apps    TYPE tt_app,
        lt_out     TYPE tt_out,
        lv_expiry  TYPE d,
        lv_days    TYPE i,
        lv_light   TYPE c LENGTH 1.

  TRY.
      DATA(lo_graph) = NEW lcl_graph_client( iv_tenant = CONV #( p_tenant )
                                             iv_client = CONV #( p_client )
                                             iv_secret = CONV #( p_secret ) ).
      lt_apps = lo_graph->get_applications( ).
    CATCH lcx_error INTO DATA(lx_err).
      MESSAGE lx_err->get_text( ) TYPE 'I' DISPLAY LIKE 'E'.
      RETURN.
  ENDTRY.

  LOOP AT lt_apps INTO DATA(ls_app).
    LOOP AT ls_app-password_credentials INTO DATA(ls_cred).

      " endDateTime looks like 2026-10-01T00:00:00Z -> take the date part
      lv_expiry = replace( val  = substring( val = ls_cred-end_date_time len = 10 )
                           sub  = `-`
                           with = ``
                           occ  = 0 ).
      lv_days = lv_expiry - sy-datum.

      lv_light = COND #( WHEN lv_days < 0       THEN '1'
                         WHEN lv_days <= p_days THEN '2'
                         ELSE                        '3' ).

      IF p_all = abap_false AND lv_light = '3'.
        CONTINUE.
      ENDIF.

      APPEND VALUE #( light       = lv_light
                      app_name    = ls_app-display_name
                      app_id      = ls_app-app_id
                      secret_name = ls_cred-display_name
                      hint        = ls_cred-hint
                      expiry      = lv_expiry
                      days_left   = lv_days ) TO lt_out.
    ENDLOOP.
  ENDLOOP.

  IF lt_out IS INITIAL.
    MESSAGE |No secrets expiring within { p_days } days| TYPE 'S'.
    RETURN.
  ENDIF.

  SORT lt_out BY days_left ASCENDING.

  " ALV output
  TRY.
      cl_salv_table=>factory( IMPORTING r_salv_table = DATA(lo_alv)
                              CHANGING  t_table      = lt_out ).

      DATA(lo_cols) = lo_alv->get_columns( ).
      lo_cols->set_optimize( ).
      lo_cols->set_exception_column( 'LIGHT' ).

      DATA(lt_hdr) = VALUE tt_hdr( ( col = 'APP_NAME'    txt = 'Application' )
                                   ( col = 'APP_ID'      txt = 'App (Client) ID' )
                                   ( col = 'SECRET_NAME' txt = 'Secret Name' )
                                   ( col = 'HINT'        txt = 'Hint' )
                                   ( col = 'EXPIRY'      txt = 'Expires On' )
                                   ( col = 'DAYS_LEFT'   txt = 'Days Left' ) ).
      LOOP AT lt_hdr INTO DATA(ls_hdr).
        DATA(lo_col) = lo_cols->get_column( ls_hdr-col ).
        lo_col->set_long_text( ls_hdr-txt ).
        lo_col->set_medium_text( CONV #( ls_hdr-txt ) ).
        lo_col->set_short_text( CONV #( ls_hdr-txt ) ).
      ENDLOOP.

      lo_alv->get_functions( )->set_all( ).
      lo_alv->display( ).

    CATCH cx_salv_error INTO DATA(lx_salv).
      MESSAGE lx_salv->get_text( ) TYPE 'I' DISPLAY LIKE 'E'.
  ENDTRY.
